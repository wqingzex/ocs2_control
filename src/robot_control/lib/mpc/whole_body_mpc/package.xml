<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>whole_body_mpc</name>
  <version>0.4.4</version>
  <description>
    OCS2-based MPC controller for wheel-based humanoid robots with dual arms.
    Supports ModeSchedule for task switching, bimanual coupling, and body tracking.
  </description>
  <maintainer email="developer@example.com">Developer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Reuse mobile_manipulator (includes all OCS2 dependencies) -->
  <depend>ocs2_mobile_manipulator</depend>
  <depend>mpc_core</depend>
  <depend>robot_controller_core</depend>
  <depend>trajectory_manager</depend>
  <depend>robot_control_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
