<?xml version="1.0" ?>
<robot name="fa_w2_body" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="variant" default=""/>
	<xacro:arg name="collider" default="simple"/>
	<xacro:arg name="isaac" default="true"/>

	<link name="base_link"/>
	<xacro:include filename="$(find fa_w2_body_description)/xacro/body.xacro"/>
	<xacro:body variant="$(arg variant)" collider="$(arg collider)" isaac="$(arg isaac)"/>
</robot>
