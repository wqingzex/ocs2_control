<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find jodell_description)/xacro/ros2_control/side_system.xacro"/>

  <xacro:macro name="jodell_usb_side_system" params="side serial_port rw_rate:=''">
    <xacro:side_ros2_control_system name="${side}_end_effector" rw_rate="${rw_rate}">
      <contents>
        <hardware>
          <plugin>end_effector_hardware/GripperModbusHardware</plugin>
          <param name="gripper_type">jodell</param>
          <param name="serial_port">${serial_port}</param>
        </hardware>
        <joint name="${side}_gripper_joint">
          <command_interface name="position"/>
          <state_interface name="position">
            <param name="initial_value">0</param>
          </state_interface>
        </joint>
      </contents>
    </xacro:side_ros2_control_system>
  </xacro:macro>

</robot>
