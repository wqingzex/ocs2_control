<?xml version="1.0"?>
<robot name="LinkerHand_$(arg type)" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="serial_port" default=""/>

    <link name="world"/>

    <joint name="world_fixed" type="fixed">
        <parent link="world"/>
        <child link="hand_base"/>
        <origin/>
    </joint>

    <xacro:include filename="$(find linkerhand_description)/xacro/hand.xacro"/>

    <ros2_control name="linkerhand_system" type="system">
        <hardware>
            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gz'}">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>

            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
                <plugin>mock_components/GenericSystem</plugin>
            </xacro:if>

            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'isaac'}">
                <plugin>topic_based_hardware/TopicBasedSystem</plugin>
                <param name="joint_commands_topic">/isaac/joint_command</param>
                <param name="joint_states_topic">/isaac/joint_states</param>
                <param name="sum_wrapped_joint_states">false</param>
                <param name="initialize_commands_from_state">true</param>
            </xacro:if>

            <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
                <xacro:if value="${not '$(arg serial_port)'.strip()}">
                    ${xacro.fatal('serial_port is required for a real USB-RS485 hand')}
                </xacro:if>
                <plugin>end_effector_hardware/EndEffectorHardware</plugin>
                <param name="device">linkerhand_$(arg type)</param>
                <param name="side">${'left' if '$(arg direction)' == '1' else 'right'}</param>
                <param name="bus">usb_rs485://$(arg serial_port)?baud=115200</param>
            </xacro:if>
        </hardware>

        <!-- Support type: l6 -->
        <xacro:if value="${'$(arg type)' == 'l6'}">
            <xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/l6.xacro"/>
            <xacro:linkerhand_l6_interfaces name=""/>
        </xacro:if>
    </ros2_control>

    <xacro:arg name="gazebo" default="false"/>
    <xacro:if value="$(arg gazebo)">
        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find linkerhand_description)/config/ros2_control/ros2_controllers.yaml</parameters>
            </plugin>
        </gazebo>
    </xacro:if>
</robot>

