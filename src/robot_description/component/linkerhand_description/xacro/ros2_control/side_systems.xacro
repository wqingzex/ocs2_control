<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/side_system.xacro"/>
  <xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/l6.xacro"/>

  <!-- LinkerHand on a USB-CAN adapter (classic CAN, 1 Mbit/s), driven by end_effector_hardware/LinkerHandCanHardware.
       One system per hand; the CAN ID comes from hand_side (left 0x28, right 0x27).
       rw_rate: ros2_control read/write rate [Hz] of this system; empty = 50 (the I/O thread polls at 50 Hz). -->
  <xacro:macro name="linkerhand_usb_can_side_system" params="side hand_type can_interface read_tactile:=false rw_rate:=''">
    <xacro:unless value="${hand_type == 'linkerhand_l6'}">
      ${xacro.fatal('linkerhand_usb_can_side_system: hand_type ' + hand_type + ' is not supported on CAN (only linkerhand_l6)')}
    </xacro:unless>
    <xacro:side_ros2_control_system name="${side}_end_effector" rw_rate="${rw_rate if rw_rate != '' else 50}">
      <contents>
        <hardware>
          <plugin>end_effector_hardware/LinkerHandCanHardware</plugin>
          <param name="hand_type">${hand_type}</param>
          <param name="hand_side">${side}</param>
          <param name="can_interface">${can_interface}</param>
          <param name="read_feedback">true</param>
          <param name="read_tactile">${read_tactile}</param>
          <param name="${side}_tool_torque">1.0</param>
          <param name="${side}_tool_velocity">1.0</param>
        </hardware>
        <xacro:linkerhand_l6_interfaces name="${side}_hand"/>
      </contents>
    </xacro:side_ros2_control_system>
  </xacro:macro>

</robot>
