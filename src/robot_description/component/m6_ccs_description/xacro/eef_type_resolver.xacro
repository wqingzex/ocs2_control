<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Map an end effector (jodell_rg75, linkerhand_l6, xhand1, wuji_hand2; empty or none = nothing) to per-side
         hand/gripper/pad properties. The same names as robot.end_effector in robot.local.yaml. -->
    <xacro:macro name="set_side_eef_types" params="side type_key">
        <xacro:property name="${side}_hand_type" value="" scope="parent"/>
        <xacro:property name="${side}_gripper_type" value="" scope="parent"/>
        <xacro:property name="${side}_gripper_pad" value="default" scope="parent"/>

        <xacro:unless value="${type_key in ['', 'none', 'jodell_rg75', 'linkerhand_l6', 'xhand1', 'wuji_hand2']}">
            ${xacro.fatal('unknown end effector ' + type_key + ' for the ' + side + ' side (jodell_rg75, linkerhand_l6, xhand1, wuji_hand2, none)')}
        </xacro:unless>
        <xacro:if value="${type_key == 'jodell_rg75'}">
            <xacro:property name="${side}_gripper_type" value="rg75" scope="parent"/>
        </xacro:if>
        <xacro:if value="${type_key == 'linkerhand_l6'}">
            <xacro:property name="${side}_hand_type" value="linkerhand_l6" scope="parent"/>
        </xacro:if>
        <xacro:if value="${type_key == 'xhand1'}">
            <xacro:property name="${side}_hand_type" value="xhand1" scope="parent"/>
        </xacro:if>
        <xacro:if value="${type_key == 'wuji_hand2'}">
            <xacro:property name="${side}_hand_type" value="wuji_hand2" scope="parent"/>
        </xacro:if>
    </xacro:macro>

</robot>
