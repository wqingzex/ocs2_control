<?xml version="1.0"?>

<robot name="M6_CCS" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="collider" default="convex"/>
	<xacro:arg name="skin" default="default"/>
	<xacro:arg name="variant" default=""/>
	<xacro:arg name="arms" default="dual"/>                  <!-- which arms: dual | left | right -->
	<xacro:arg name="end_effector" default=""/>             <!-- both sides; left_/right_end_effector override one side -->
	<xacro:arg name="left_end_effector" default=""/>
	<xacro:arg name="right_end_effector" default=""/>
	<xacro:arg name="eef_fixed_joints" default="false"/>
	<xacro:arg name="left_tcp_offset_xyz" default="0 0 0"/>
	<xacro:arg name="left_tcp_offset_rpy" default="0 0 0"/>
	<xacro:arg name="right_tcp_offset_xyz" default="0 0 0"/>
	<xacro:arg name="right_tcp_offset_rpy" default="0 0 0"/>
	<!-- 从 type 参数解析 arm_config / 对称末端 -->
	<xacro:property name="arms_arg" value="$(arg arms)"/>
	<xacro:property name="end_effector_arg" value="$(arg end_effector)"/>
	<xacro:property name="variant_arg" value="$(arg variant)"/>
	<xacro:property name="left_end_effector_arg" value="$(arg left_end_effector)"/>
	<xacro:property name="right_end_effector_arg" value="$(arg right_end_effector)"/>
	<xacro:property name="effective_left_type" value="${left_end_effector_arg if left_end_effector_arg != '' else end_effector_arg}"/>
	<xacro:property name="effective_right_type" value="${right_end_effector_arg if right_end_effector_arg != '' else end_effector_arg}"/>
	<xacro:unless value="${arms_arg in ['dual', 'left', 'right']}">
		${xacro.fatal('arms must be dual, left or right, got ' + arms_arg)}
	</xacro:unless>

	<!-- 默认值 -->
	<xacro:property name="selected_arm_config" value="dual"/>
	<xacro:property name="selected_gripper_type" value="none"/>
	<xacro:property name="selected_gripper_pad" value="default"/>

	<!-- 从 type 解析 arm_config 和 gripper_type -->
	<!-- 单臂配置 -->
	<xacro:if value="${arms_arg == 'left'}">
		<xacro:property name="selected_arm_config" value="left"/>
	</xacro:if>
	<xacro:if value="${arms_arg == 'right'}">
		<xacro:property name="selected_arm_config" value="right"/>
	</xacro:if>
	<!-- 双臂配置 -->

	<xacro:include filename="$(find m6_ccs_description)/xacro/arm.xacro"/>
	<xacro:include filename="$(find m6_ccs_description)/xacro/arm_mount.xacro"/>

	<!-- 单左臂 -->
	<xacro:if value="${selected_arm_config == 'left'}">
		<xacro:M6_CCS skin="$(arg skin)" variant="$(arg variant)"
			tcp_offset_xyz="$(arg left_tcp_offset_xyz)"
			tcp_offset_rpy="$(arg left_tcp_offset_rpy)"/>
	</xacro:if>

	<!-- 单右臂 -->
	<xacro:if value="${selected_arm_config == 'right'}">
		<xacro:M6_CCS direction="-1" skin="$(arg skin)" variant="$(arg variant)"
			tcp_offset_xyz="$(arg right_tcp_offset_xyz)"
			tcp_offset_rpy="$(arg right_tcp_offset_rpy)"/>
	</xacro:if>

	<!-- 双臂配置 -->
	<xacro:if value="${selected_arm_config == 'dual'}">
		<xacro:if value="${variant_arg == 'desktop'}">
			<link name="base_link"/>
			<link name="arm_base">
				<visual>
					<geometry>
						<mesh filename="file://$(find m6_ccs_description)/meshes/desktop_base.glb"/>
					</geometry>
				</visual>
				<collision>
					<origin xyz="0 0 0.324331"/>
					<geometry>
						<box size="0.10045 0.100398 0.648662"/>
					</geometry>
				</collision>
			</link>

			<joint name="arm_base_joint" type="fixed">
				<parent link="base_link"/>
				<child link="arm_base"/>
			</joint>

			<xacro:DualArmMount parent="arm_base" left_xyz="0 0.12 0.701" right_xyz="0 -0.12 0.701"/>
		</xacro:if>

		<xacro:unless value="${variant_arg == 'desktop'}">
			<link name="base_link"/>
			<link name="arm_base">
				<collision>
					<origin xyz="0.0091 0 -0.25"/>
					<geometry>
						<box size="0.2000 0.3 0.4029"/>
					</geometry>
				</collision>
			</link>

			<joint name="arm_base_joint" type="fixed">
				<parent link="base_link"/>
				<child link="arm_base"/>
			</joint>

			<xacro:DualArmMount parent="arm_base"/>
		</xacro:unless>

		<xacro:M6_CCS name="left" skin="$(arg skin)" variant="$(arg variant)"
			tcp_offset_xyz="$(arg left_tcp_offset_xyz)"
			tcp_offset_rpy="$(arg left_tcp_offset_rpy)"/>
		<xacro:M6_CCS name="right" direction="-1" skin="$(arg skin)" variant="$(arg variant)"
			tcp_offset_xyz="$(arg right_tcp_offset_xyz)"
			tcp_offset_rpy="$(arg right_tcp_offset_rpy)"/>

		<xacro:include filename="$(find m6_ccs_description)/xacro/eef_type_resolver.xacro"/>
		<xacro:set_side_eef_types side="left" type_key="${effective_left_type}"/>
		<xacro:set_side_eef_types side="right" type_key="${effective_right_type}"/>
		<xacro:include filename="$(find m6_ccs_description)/xacro/eefs.xacro"/>
		<xacro:EndEffectors
			eef_fixed_joints="$(arg eef_fixed_joints)"
			left_hand_type="${left_hand_type}"
			left_gripper_type="${left_gripper_type}"
			left_gripper_pad="${left_gripper_pad}"
			right_hand_type="${right_hand_type}"
			right_gripper_type="${right_gripper_type}"
			right_gripper_pad="${right_gripper_pad}"/>
	</xacro:if>
</robot>
