<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/interfaces.xacro"/>
	<xacro:include filename="$(find jodell_description)/xacro/ros2_control/RG75-300.xacro"/>
	<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/l6.xacro"/>
	<xacro:include filename="$(find xhand1_description)/xacro/ros2_control/side_systems.xacro"/>
	<xacro:include filename="$(find wuji_description)/xacro/ros2_control/hand2.xacro"/>

	<xacro:macro name="side_gripper_joint" params="side">
		<joint name="${side}_gripper_joint">
			<command_interface name="position"/>
			<state_interface name="position">
				<param name="initial_value">0</param>
			</state_interface>
		</joint>
	</xacro:macro>

	<xacro:macro name="side_gripper_interfaces_sim" params="side gripper_type">
		<xacro:if value="${gripper_type == 'rg75'}">
			<xacro:rg75_interfaces name="${side}"/>
		</xacro:if>
	</xacro:macro>

	<xacro:macro name="side_hand_interfaces" params="side hand_type">
		<xacro:if value="${hand_type == 'linkerhand_l6'}">
			<xacro:linkerhand_l6_interfaces name="${side}_hand"/>
		</xacro:if>
		<xacro:if value="${hand_type == 'xhand1'}">
			<xacro:xhand1_interfaces name="${side}_hand"/>
		</xacro:if>
		<xacro:if value="${hand_type == 'wuji_hand2'}">
			<xacro:wuji_hand2_interfaces name="${side}_hand"/>
		</xacro:if>
	</xacro:macro>

	<!-- mode: sim | real. On the real robot the end effectors are components of their own (external_ee_systems), the arms
	     system only has the arm joints. -->
	<xacro:macro name="dual_arm_ee_block" params="mode">
		<xacro:m6_interfaces name="left"/>
		<xacro:m6_interfaces name="right"/>

		<xacro:if value="${mode == 'sim'}">
			<xacro:if value="${left_gripper_type != ''}">
				<xacro:side_gripper_interfaces_sim side="left" gripper_type="${left_gripper_type}"/>
			</xacro:if>
			<xacro:if value="${right_gripper_type != ''}">
				<xacro:side_gripper_interfaces_sim side="right" gripper_type="${right_gripper_type}"/>
			</xacro:if>
			<xacro:if value="${left_hand_type != ''}">
				<xacro:side_hand_interfaces side="left" hand_type="${left_hand_type}"/>
			</xacro:if>
			<xacro:if value="${right_hand_type != ''}">
				<xacro:side_hand_interfaces side="right" hand_type="${right_hand_type}"/>
			</xacro:if>
		</xacro:if>

	</xacro:macro>

	<!-- Single left arm (m6_ccs type:=left); the single-arm gripper is not wired, gripper_type is ignored -->
	<xacro:macro name="single_arm_ee_block" params="mode gripper_type:=none">
		<xacro:m6_interfaces name=""/>
	</xacro:macro>

</robot>
