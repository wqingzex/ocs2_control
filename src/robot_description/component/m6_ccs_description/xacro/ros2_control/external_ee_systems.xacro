<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/end_effector_interfaces.xacro"/>
	<xacro:include filename="$(find linkerhand_description)/xacro/ros2_control/side_systems.xacro"/>
	<xacro:include filename="$(find wuji_description)/xacro/ros2_control/side_systems.xacro"/>

	<xacro:macro name="side_usb_hand_system" params="side hand_type serial_port">
		<xacro:property name="usb_hand_system_name" value="linkerhand_6"/>
		<ros2_control name="${usb_hand_system_name}_${side}_system" type="system">
			<hardware>
				<plugin>end_effector_hardware/LinkerHandRs485Hardware</plugin>
				<param name="serial_port">${serial_port}</param>
				<param name="hand_type">${hand_type}</param>
				<param name="hand_side">${side}</param>
				<param name="max_speed_ratio">1.0</param>
			</hardware>
			<xacro:side_hand_interfaces side="${side}" hand_type="${hand_type}"/>
		</ros2_control>
	</xacro:macro>

	<!-- Dexterous hands outside the arm:
	       usb      USB-RS485, end_effector_hardware: LinkerHand L6, XHand1
	       usb_can  USB-CAN, end_effector_hardware: LinkerHand L6 (classic CAN 1 Mbit/s, one interface per hand or shared)
	       ethernet wuji_hardware: Wuji Hand 2 (found by scanning, matched by hand_side)
	     body_can_interface: the waist / head bus (CAN FD) of a whole robot, empty for a dual-arm robot; a hand on
	     the same interface would reconfigure it to classic CAN, so that is rejected. -->
	<xacro:macro name="external_ee_systems" params="
		usb_left_port:=/dev/ttyUSB0
		usb_right_port:=/dev/ttyUSB2
		left_ee_rw_rate:=''
		right_ee_rw_rate:=''
		left_ee_can_interface:=can0
		right_ee_can_interface:=can1
		body_can_interface:=''">
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'linkerhand_l6'}">
			<xacro:side_usb_hand_system side="left" hand_type="${left_hand_type}" serial_port="${usb_left_port}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'linkerhand_l6'}">
			<xacro:side_usb_hand_system side="right" hand_type="${right_hand_type}" serial_port="${usb_right_port}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb' and left_hand_type == 'xhand1'}">
			<xacro:xhand1_rs485_side_system side="left" serial_port="${usb_left_port}" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb' and right_hand_type == 'xhand1'}">
			<xacro:xhand1_rs485_side_system side="right" serial_port="${usb_right_port}" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'ethernet' and left_hand_type == 'wuji_hand2'}">
			<xacro:wuji_hand2_ethernet_side_system side="left" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'ethernet' and right_hand_type == 'wuji_hand2'}">
			<xacro:wuji_hand2_ethernet_side_system side="right" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${left_drive_type == 'usb_can'}">
			<xacro:if value="${body_can_interface != '' and left_ee_can_interface == body_can_interface}">
				${xacro.fatal('left_ee_can_interface ' + left_ee_can_interface + ' is the waist / head bus (body_can_interface); use another CAN interface for the hand')}
			</xacro:if>
			<xacro:linkerhand_usb_can_side_system side="left" hand_type="${left_hand_type}" can_interface="${left_ee_can_interface}" rw_rate="${left_ee_rw_rate}"/>
		</xacro:if>
		<xacro:if value="${right_drive_type == 'usb_can'}">
			<xacro:if value="${body_can_interface != '' and right_ee_can_interface == body_can_interface}">
				${xacro.fatal('right_ee_can_interface ' + right_ee_can_interface + ' is the waist / head bus (body_can_interface); use another CAN interface for the hand')}
			</xacro:if>
			<xacro:linkerhand_usb_can_side_system side="right" hand_type="${right_hand_type}" can_interface="${right_ee_can_interface}" rw_rate="${right_ee_rw_rate}"/>
		</xacro:if>
	</xacro:macro>

</robot>
