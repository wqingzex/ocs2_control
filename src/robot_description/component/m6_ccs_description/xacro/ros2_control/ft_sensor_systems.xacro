<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!--
		KWR75 force / torque sensors (end_effector_hardware/Kwr75Sensor), one ros2_control sensor per side, on the
		real robot only. left_ft_bus / right_ft_bus (launch: xacro_left_ft_bus:=...) say where it is wired:
		  ''                                   no sensor (default)
		  arm_rs485                            the arm's flange RS485 port 2: arm_rs485://<device_ip>/<side>/port2
		  usb_rs485:///dev/ttyUSB4?baud=...    a USB-RS485 adapter (any robot_comm bus name)
		Exports left_ft_sensor / right_ft_sensor; left_ft_broadcaster / right_ft_broadcaster publish them.
	-->
	<xacro:arg name="left_ft_bus" default=""/>
	<xacro:arg name="right_ft_bus" default=""/>

	<xacro:macro name="side_ft_sensor_system" params="side bus device_ip">
		<xacro:if value="${bus.startswith('arm_rs485://')}">
			${xacro.fatal(side + '_ft_bus: write arm_rs485 (the arm port 2 is filled in), got ' + bus)}
		</xacro:if>
		<ros2_control name="${side}_ft" type="sensor">
			<hardware>
				<plugin>end_effector_hardware/Kwr75Sensor</plugin>
				<param name="bus">${'arm_rs485://' + device_ip + '/' + side + '/port2' if bus == 'arm_rs485' else bus}</param>
			</hardware>
			<sensor name="${side}_ft_sensor">
				<state_interface name="force.x"/>
				<state_interface name="force.y"/>
				<state_interface name="force.z"/>
				<state_interface name="torque.x"/>
				<state_interface name="torque.y"/>
				<state_interface name="torque.z"/>
			</sensor>
		</ros2_control>
	</xacro:macro>

	<xacro:macro name="ft_sensor_systems" params="device_ip">
		<xacro:property name="left_ft_bus" value="$(arg left_ft_bus)"/>
		<xacro:property name="right_ft_bus" value="$(arg right_ft_bus)"/>
		<xacro:if value="${left_ft_bus != ''}">
			<xacro:side_ft_sensor_system side="left" bus="${left_ft_bus}" device_ip="${device_ip}"/>
		</xacro:if>
		<xacro:if value="${right_ft_bus != ''}">
			<xacro:side_ft_sensor_system side="right" bus="${right_ft_bus}" device_ip="${device_ip}"/>
		</xacro:if>
	</xacro:macro>

</robot>
