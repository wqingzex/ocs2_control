<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_comm_modbus</name>
  <version>0.1.0</version>
  <description>Modbus master for the hardware drivers: a libmodbus RTU implementation of robot_comm::ModbusMaster, and a mock slave for tests.</description>
  <maintainer email="TODO@email.com"/>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>robot_comm_core</depend>
  <depend>robot_comm_serial</depend>
  <depend>libmodbus-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
