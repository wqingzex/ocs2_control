<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>end_effector_hardware</name>
  <version>2.0.0</version>
  <description>ros2_control hardware interfaces for external end effectors (grippers, dexterous hands, force sensors) on RS485 / Modbus or CAN. Transport is robot_comm_*; each device's protocol lives here.</description>
  
  <maintainer email="TODO@email.com"/>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>
  <depend>robot_comm_core</depend>
  <depend>robot_comm_serial</depend>
  <depend>robot_comm_modbus</depend>
  <depend>robot_comm_can</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  
  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>hardware_interface</test_depend>
  <test_depend>ros2_control_test_assets</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/end_effector_hardware.xml"/>
  </export>
</package>
