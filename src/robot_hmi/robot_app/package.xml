<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_app</name>
  <version>0.1.0</version>
  <description>
    Teleoperation application: module start/stop and monitoring, command line, web console,
    recording and diagnostics, driven by a YAML config.
  </description>
  <maintainer email="TODO@email.com"/>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>



  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-ruamel.yaml</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>robot_config</exec_depend>
  <exec_depend>robot_utils</exec_depend>
  <exec_depend>camera_setup</exec_depend>
  <exec_depend>end_effector_setup</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>target_generator</exec_depend>
  <exec_depend>robot_bringup</exec_depend>
  <exec_depend>joystick_teleop</exec_depend>
  <exec_depend>xr_teleop</exec_depend>
  <exec_depend>robot_control_msgs</exec_depend>
  <exec_depend>robot_visualize</exec_depend>
  <exec_depend>robot_navigation</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-httpx</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
