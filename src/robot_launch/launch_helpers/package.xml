<?xml version="1.0"?>
<package format="3">
  <name>launch_helpers</name>
  <version>1.5.0</version>
  <description>Shared Python library for robot launch: robot/profile resolution, URDF generation, ros2_control composition, controller spawners</description>

  <license>BSD-3</license>

  <maintainer email="biao876990970@hotmail.com">Huang Zhenbiao</maintainer>

  <exec_depend>xacro</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
