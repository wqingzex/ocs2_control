<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_startup</name>
  <version>0.1.0</version>
  <description>Whole-robot launch files: split-body, whole-body and dual-arm startup that assemble the URDF, ros2_control and the controllers</description>
  <maintainer email="TODO@email.com"/>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch_helpers</exec_depend>
  <exec_depend>robot_config</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>target_generator</exec_depend>
  <exec_depend>arm_controller</exec_depend>
  <exec_depend>whole_body_controller</exec_depend>
  <exec_depend>joint_controller</exec_depend>
  <exec_depend>end_effector_controller</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
