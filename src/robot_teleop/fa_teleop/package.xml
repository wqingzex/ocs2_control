<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fa_teleop</name>
  <version>0.1.0</version>
  <description>
    W2 VR teleoperation: XRoboToolkit (Pico App + PC Service) bridge publishing /xr/*,
    Orbbec camera launch and one-shot bringup driven by a YAML config.
  </description>
  <maintainer email="wqingzey@gmail.com">wqingze</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>robot_log</depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>eigen</depend>
  <depend>nlohmann-json-dev</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-ruamel.yaml</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>w2_payload</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>teleop_command</exec_depend>
  <exec_depend>robot_bringup</exec_depend>
  <exec_depend>arms_teleop</exec_depend>
  <exec_depend>robot_control_msgs</exec_depend>
  <exec_depend>robot_visualize</exec_depend>
  <exec_depend>robot_navigation</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-httpx</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
