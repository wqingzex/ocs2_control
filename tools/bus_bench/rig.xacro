<?xml version="1.0"?>
<!-- tools/bus_bench: one end effector on EndEffectorHardware over the bus given by `bus` (or on mock_components with
     mock:=true), plus the URDF links its joints need. Not part of any robot description. -->
<robot name="bus_bench" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="device" default="xhand1"/>
  <xacro:arg name="side" default="left"/>
  <xacro:arg name="bus" default=""/>
  <xacro:arg name="io_mode" default="async"/>
  <xacro:arg name="torque" default="0.8"/>
  <xacro:arg name="mock" default="false"/>

  <xacro:if value="${'$(arg device)' != 'xhand1'}">
    ${xacro.fatal('bus_bench: device ' + '$(arg device)' + ' has no rig yet (supported: xhand1)')}
  </xacro:if>

  <xacro:include filename="$(find xhand1_description)/xacro/ros2_control/side_systems.xacro"/>
  <xacro:include filename="$(find xhand1_description)/xacro/xhand1.xacro"/>

  <link name="world"/>
  <xacro:XHand1 name="$(arg side)_hand" direction="${1 if '$(arg side)' == 'left' else -1}"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="$(arg side)_hand_hand_base"/>
    <origin/>
  </joint>

  <ros2_control name="$(arg side)_end_effector" type="system">
    <hardware>
      <xacro:if value="$(arg mock)">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg mock)">
        <plugin>end_effector_hardware/EndEffectorHardware</plugin>
        <param name="device">$(arg device)</param>
        <param name="side">$(arg side)</param>
        <param name="bus">$(arg bus)</param>
        <param name="torque">$(arg torque)</param>
        <param name="io_mode">$(arg io_mode)</param>
      </xacro:unless>
    </hardware>
    <xacro:xhand1_interfaces name="$(arg side)_hand" commands="position"/>
  </ros2_control>
</robot>
